
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =====================================================
    // Helper Functions
    // =====================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function userExists() {
      return isSignedIn()
        && exists(
          /databases/$(database)/documents/users/$(request.auth.uid)
        );
    }

    function userDoc() {
      return get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      );
    }

    function isActive() {
      return userExists()
        && userDoc().data.status_akun == 'aktif';
    }

    function role() {
      return userDoc().data.role;
    }

    function isRole(allowedRoles) {
      return isActive()
        && role() in allowedRoles;
    }

    // =====================================================
    // User Profiles
    // =====================================================

    match /users/{userId} {

      // Semua pengguna terautentikasi dapat membaca profil
      allow read: if isSignedIn();

      // Hanya Sekretaris aktif yang dapat membuat pengguna
      allow create: if isRole(['sekretaris']);

      // Pengguna dapat memperbarui profil sendiri.
      // Sekretaris dan Ketua dapat memperbarui profil pengguna lain.
      allow update: if isActive() && (
        request.auth.uid == userId ||
        isRole(['sekretaris', 'ketua'])
      );

      // Penghapusan profil tidak diperbolehkan
      allow delete: if false;
    }

    // =====================================================
    // Divisions
    // =====================================================

    match /divisi/{divisionId} {
      allow read: if isActive();
      allow write: if false;
    }

    // =====================================================
    // Tasks
    // =====================================================

    match /tasks/{taskId} {

      allow read: if isActive();

      // Sekretaris membuat tugas
      allow create: if isRole(['sekretaris'])
        && request.resource.data.created_by == request.auth.uid
        && request.resource.data.status == 'todo'
        && request.resource.data.target_role is string;

      // Sekretaris dapat memperbarui tugas
      allow update: if isRole(['sekretaris']);

      // Penerima dapat menandai tugas selesai
      allow update: if isActive()
        && role() == resource.data.target_role
        && request.resource.data.status == 'done'
        && request.resource.data.completed_by == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            'status',
            'completed_by',
            'completed_at'
          ]);

      // Hanya Sekretaris yang dapat menghapus tugas
      allow delete: if isRole(['sekretaris']);
    }

    // =====================================================
    // Agendas
    // =====================================================

    match /agenda/{agendaId} {

      // Semua pengguna aktif dapat membaca agenda
      allow read: if isActive();

      // Hanya Sekretaris yang dapat membuat agenda
      allow create: if isRole(['sekretaris'])
        && request.resource.data.created_by == request.auth.uid;

      // Hanya Sekretaris yang dapat memperbarui agenda
      allow update: if isRole(['sekretaris']);

      // Hanya Sekretaris yang dapat menghapus agenda
      allow delete: if isRole(['sekretaris']);
    }

    // =====================================================
    // Finance Transactions
    // =====================================================

    match /finance_transactions/{txId} {

      // Semua pengguna aktif dapat membaca data kas
      allow read: if isActive();

      // Hanya Bendahara aktif yang dapat membuat transaksi
      allow create: if isRole(['bendahara']);

      // Hanya Bendahara aktif yang dapat menghapus transaksi
      allow delete: if isRole(['bendahara']);

      // Bendahara dapat memperbarui seluruh transaksi.
      // Ketua dan Wakil Ketua dapat memperbarui transaksi
      // sesuai kebutuhan konfirmasi.
      allow update: if isRole([
        'bendahara',
        'ketua',
        'wakil_ketua'
      ]);

      // -------------------------------------------------
      // Member Payments
      // -------------------------------------------------

      match /payments/{userId} {

        allow read: if isActive();

        // Anggota hanya dapat membuat atau memperbarui
        // pembayaran miliknya sendiri.
        // Bendahara dapat membuat atau memperbarui pembayaran
        // anggota untuk kebutuhan verifikasi.
        allow create, update: if isActive() && (
          request.auth.uid == userId ||
          role() == 'bendahara'
        );

        // Penghapusan pembayaran tidak diperbolehkan
        allow delete: if false;
      }
    }
  }
}
